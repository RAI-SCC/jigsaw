# KIT HoreKa. Seed preset - this is where the container path is being developed.
# Treat it as a working example, not a guarantee; adjust paths to your account.
#
# Values use ${VAR:-default} so anything you export before calling run.sh wins.
#
# Usage:
#   JIGSAW_SITE=horeka srun --account=... --partition=accelerated-h100 \
#       --nodes=1 --ntasks-per-node=4 --gres=gpu:4 \
#       scripts/run.sh python -m your_script

export JIGSAW_SIF="${JIGSAW_SIF:-/home/hk-project-epais/ke4365/containers/pytorch26.02.sif}"
export JIGSAW_VENV="${JIGSAW_VENV:-$HOME/envs/jigsaw-te}"

# apptainer is in the default PATH on HoreKa; no module needed.
# /hkfs covers home + project + work; /scratch is the node-local fast tier.
export JIGSAW_BINDS="${JIGSAW_BINDS:-/hkfs,/scratch}"

# HoreKa compute nodes talk over InfiniBand.
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-ib0}"
export MASTER_PORT="${MASTER_PORT:-29500}"
