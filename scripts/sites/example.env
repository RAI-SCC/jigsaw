# Site preset template. Copy to scripts/sites/<yourcluster>.env and edit, or
# point at it directly with JIGSAW_SITE_FILE=/path/to/my.env.
#
# scripts/run.sh sources this file, so anything valid in bash works here.
# Only JIGSAW_SIF is required; everything else has a default.
#
# Every value is written as ${VAR:-default}, so a value exported before calling
# run.sh overrides the preset. Keep that form when adding lines.

# --- required -------------------------------------------------------------
# Absolute path to the container image on this cluster's filesystem.
export JIGSAW_SIF="${JIGSAW_SIF:-$HOME/containers/pytorch26.04.sif}"

# --- python environment -------------------------------------------------------
# Host venv created from *inside* the image with --system-site-packages and an
# editable jigsaw install (see containers/README.md). Leave unset to use the
# image's own interpreter plus PYTHONPATH=<repo root>.
export JIGSAW_VENV="${JIGSAW_VENV:-$HOME/envs/jigsaw-te}"

# --- container runtime ------------------------------------------------------
# export JIGSAW_APPTAINER="${JIGSAW_APPTAINER:-apptainer}"  # or "singularity"
# export JIGSAW_MODULES="${JIGSAW_MODULES:-}"               # modules to load before launching
# export JIGSAW_ENV_FILE="${JIGSAW_ENV_FILE:-}"             # extra --env-file for apptainer

# --- bind mounts ------------------------------------------------------------
# Comma-separated. Home and $PWD are auto-bound; add scratch / project / data.
export JIGSAW_BINDS="${JIGSAW_BINDS:-/scratch}"

# --- distributed / NCCL ---------------------------------------------------
# MASTER_ADDR/MASTER_PORT are derived from the SLURM allocation if unset.
# export MASTER_PORT="${MASTER_PORT:-29500}"
# export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-ib0}"    # cluster fabric interface
# export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"

# --- TE knobs (run.sh defaults the first two; override only if needed) ------
# export NVTE_FRAMEWORK="${NVTE_FRAMEWORK:-pytorch}"
# export CUDA_DEVICE_MAX_CONNECTIONS="${CUDA_DEVICE_MAX_CONNECTIONS:-1}"
# export NVTE_FUSED_ATTN="${NVTE_FUSED_ATTN:-1}"            # passed through only if set
