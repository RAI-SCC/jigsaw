# JSC JUPITER. Seed preset - this is where the container path is being developed.
#
# Values use ${VAR:-default} so anything you export before calling run.sh wins.
#
# Usage:
#   JIGSAW_SITE=jupiter srun --account=... --partition=booster \
#       --nodes=1 --ntasks-per-node=4 --gres=gpu:4 \
#       scripts/run.sh python -m your_script

export JIGSAW_SIF="${JIGSAW_SIF:-$PROJECT_cexalab/kieckhefen/containers/pytorch26.02.sif}"
export JIGSAW_VENV="${JIGSAW_VENV:-$PROJECT_cexalab/kieckhefen/venvs/jigsaw-te}"

# apptainer is in the default PATH on JUPITER; no module needed.
# /hkfs covers home + project + work; /scratch is the node-local fast tier.
export JIGSAW_BINDS="${JIGSAW_BINDS:-/e/project1}"

# JUPITER compute nodes talk over InfiniBand, but the interface name is not
# uniform across partitions.
# NCCL_SOCKET_IFNAME matches by prefix, so "ib" covers every partition; without
# this NCCL bootstrap can fail inside the container with
# "Bootstrap : no socket interface found".
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-ib}"
export MASTER_PORT="${MASTER_PORT:-29500}"
